    "walkability",
    "itinerary",
    "local-search",
    "nationwide",
    "major-metros",
    "multi-city",
    "metro"
  ],
  "license": "MIT",
  "author": "Dayplay Team (https://www.dayplay.io)",
  "type": "module",
  "bin": {
    "dayplay-mcp": "bin/dayplay-mcp.js"
  },
  "main": "bin/dayplay-mcp.js",
  "exports": {
    ".": "./bin/dayplay-mcp.js"
  },
  "files": [
    "bin/",
    "skills/",
