{
  "name": "@dayplayai/mcp-server",
  "version": "1.3.2",
  "description": "DayPlay MCP \u2014 verified real-time SF Bay Area places, events & walkable itineraries for AI agents. 3 free discovery tools + AI outing planning with a free account. Remote endpoint: https://www.dayplay.io/api/mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "san-francisco",
    "bay-area",
    "oakland",
    "berkeley",
    "events-api",
    "places-api",
    "travel",
    "concierge",
    "walkability",
    "itinerary",
    "local-search"
  ],
  "license": "MIT",
  "author": "Dayplay Team (https://www.dayplay.io)",
  "type": "module",
  "bin": {
    "dayplay-mcp": "bin/dayplay-mcp.js"
  },
  "main": "bin/dayplay-mcp.js",
  "exports": {
    ".": "./bin/dayplay-mcp.js"
  },
  "files": [
    "bin/",
    "skills/",
    "smithery.yaml",
    "plugin.json",
    ".cursor/",
    ".cursor-plugin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node bin/dayplay-mcp.js",
    "smoke": "node bin/dayplay-mcp.js --smoke",
    "test": "node test/e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayplayTeam/dayplay-mcp.git"
  },
  "homepage": "https://www.dayplay.io",
  "bugs": {
    "url": "https://github.com/dayplayTeam/dayplay-mcp/issues"
  }
}
